# ==========================================
# VillageInsight DSS
# Environment Variables
# ==========================================

# ------------------------------------------
# Django
# ------------------------------------------
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------
# Database
# ------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=villageinsight_dss
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------
# Time Zone
# ------------------------------------------
TIME_ZONE=Asia/Jakarta
LANGUAGE_CODE=en-us

# ------------------------------------------
# Static & Media
# ------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# ------------------------------------------
# Email (Optional)
# ------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------
# Machine Learning
# ------------------------------------------
MODEL_PATH=backend/machine_learning/artifacts/
RULE_PATH=backend/machine_learning/rules/

# ------------------------------------------
# Security
# ------------------------------------------
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_AGE=86400