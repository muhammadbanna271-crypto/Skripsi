# ==========================================
# VillageInsight DSS
# Environment Variables
# ==========================================

# ------------------------------------------
# Django
# ------------------------------------------
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------
# Database
# ------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=villageinsight_dss
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------
# Time Zone
# ------------------------------------------
TIME_ZONE=Asia/Jakarta
LANGUAGE_CODE=en-us

# ------------------------------------------
# Static & Media
# ------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# ------------------------------------------
# Email (Optional)
# ------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------
# Systematic Literature Review
# ------------------------------------------
# Crossref needs no API key. Keep any future provider credential in
# deployment environment variables, never source control.
# Set this to a team or institutional contact email (Crossref polite pool).
CROSSREF_MAILTO=
SLR_HTTP_TIMEOUT_SECONDS=20
SLR_HTTP_MAX_RETRIES=4
SLR_HTTP_BACKOFF_SECONDS=2
# Optional but recommended to reduce Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
GEMINI_API_KEY=
SLR_LLM_PROVIDER=gemini
SLR_LLM_MODEL=gemini-3.5-flash-lite
SLR_LLM_MAX_INPUT_CHARS=60000

# ------------------------------------------
# Machine Learning
# ------------------------------------------
MODEL_PATH=backend/machine_learning/artifacts/
RULE_PATH=backend/machine_learning/rules/

# ------------------------------------------
# Security
# ------------------------------------------
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_AGE=86400